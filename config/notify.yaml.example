# ============================================================
# notify.yaml — 推送通知配置模板
# 使用方式：cp config/notify.yaml.example config/notify.yaml
#            然后填入凭证并将 enabled 改为 true
# 注意：config/notify.yaml 已被 .gitignore 排除，不会提交到仓库
# ============================================================

bark:
  enabled: false
  server_url: "https://api.day.app"
  device_key: ""          # 从 Bark App 复制设备 Key

pushplus:
  enabled: false
  token: ""               # 登录 http://www.pushplus.plus/ 获取

dingtalk:
  enabled: false
  webhook_url: ""         # 钉钉群机器人 Webhook URL
  secret: ""              # 可选：安全设置中的签名密钥

serverchan:
  enabled: false
  send_key: ""            # 注册 https://sct.ftqq.com/ 获取 SendKey

# ── 微信公众号模板消息 ────────────────────────────────────
# 前提: 需要已认证的微信服务号，并在公众平台开通模板消息功能
# 步骤:
#   1. 登录 https://mp.weixin.qq.com/ → 设置与开发 → 基本配置
#      复制 AppID 和 AppSecret
#   2. 功能 → 模板消息 → 选用/添加模板，复制模板 ID
#      模板应包含字段: first / keyword1 / keyword2 / remark
#      示例模板内容:
#        {{first.DATA}}
#        日期：{{keyword1.DATA}}
#        摘要：{{keyword2.DATA}}
#        {{remark.DATA}}
#   3. 用户需关注公众号，获取其 OpenID（可在"用户管理"页查看）
wechat_mp:
  enabled: false
  appid: ""               # 公众号 AppID（wx 开头）
  appsecret: ""           # 公众号 AppSecret
  template_id: ""         # 模板消息 ID
  openids:                # 接收推送的用户 OpenID 列表
    - ""
  url: ""                 # 可选: 点击消息后跳转的链接
